tests/compat/results.json

# v5.1+ working state — per-run brainstorm + spec lifecycle artifacts (NEVER commit)
pipeline-runs/

# Per-session HTML artifacts from html-artifacts skill (working state, NEVER commit)
.claude/artifacts/
.codex/artifacts/

# Local Claude Code worktrees managed by superpowers/git-worktrees skill
.claude/worktrees/

# npm pack tarballs — published to GitHub Releases instead
*.tgz
.npmrc

# Backups locais do /tts-style (working state)
.claude/backups/

# Secrets — never commit
.env

# OpenCode adaptation — separado para projeto irmão standalone; working state local, NEVER commit
opencode-adaptation/

# Lixo de sessão (saída de ferramenta salva por engano)
context.md

# Working-state dentro da spec do Paperclip movida para o repo (artefatos + pipeline runs)
paperclip-native-spec/.claude/
paperclip-native-spec/.pipeline/
