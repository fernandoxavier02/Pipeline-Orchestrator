# Inverse of files[] in package.json — list what NOT to publish

# Working state (never publish)
# Anchored AND globbed: a bare `.pipeline/` is not honored inside a files[]-
# whitelisted dir (e.g. commands/.pipeline/), so glob it at any depth. This
# closed the v8.0.1 leak where commands/.pipeline/sessions/*.lock shipped.
.pipeline/
**/.pipeline/
*.lock
**/*.lock
.kiro/
pipeline-runs/
.claude/worktrees/
node_modules/*
!node_modules/langfuse/
!node_modules/langfuse-core/
!node_modules/mustache/

# Tests are kept inside the package for `npm test` to work, but
# heavy fixtures and runtime artifacts are excluded:
tests/compat/results.json
tests/compat/v4-baseline/scenarios/*/mock-output.json
tests/fixtures/specs/auth-flow-*/

# Dev / CI artifacts
.github/
.codex/
.gitignore
.gitattributes
.DS_Store
*.local.md
*.tgz

# Audit reports and design docs are valuable but bulk — keep selective:
# (CHANGELOG.md + README.md + docs/audits/ + docs/diagrams/ ARE published per package.json files[])
docs/pipeline-reviews/
docs/superpowers/
docs/findings/
designs/legacy/
designs/slice-0/

# Plans / notes (working docs)
notes/
plans/
.specs/scratchpad/

# Editor / OS
.vscode/
.idea/
Thumbs.db

# Backup files
*.bak
*.orig
*~
