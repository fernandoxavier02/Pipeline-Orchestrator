<mxCell id="p9_10" value="&lt;b&gt;11 · Selar — PARA&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;contrato pronto; implementar é outro passo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="260" width="180" height="80" as="geometry"/></mxCell>
