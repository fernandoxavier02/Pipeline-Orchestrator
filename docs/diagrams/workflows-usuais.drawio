<mxCell id="d6_e10" value="se ninguém responde" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#b85450;fontSize=10;fontColor=#444444;" edge="1" parent="1" source="d6_parent" target="d6_timeout"><mxGeometry relative="1" as="geometry"/></mxCell>
