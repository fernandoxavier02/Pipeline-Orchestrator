<diagram name="3 · Conserto de bug — LEVE (bug pequeno, causa direta)" id="p3"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p3_t" value="3 · Conserto de bug — LEVE (bug pequeno, causa direta)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell>
<mxCell id="p3_n" value="Para bugs que tocam no máximo dois arquivos, conserto de ~50 linhas, sem regra de negócio importante." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="980" height="26" as="geometry"/></mxCell>
<mxCell id="p3_0" value="&lt;b&gt;1 · Entender&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;comportamento do bug&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p3_1" value="&lt;b&gt;2 · Análise&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;+ teste que tem que falhar&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="80" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p3_2" value="&lt;b&gt;3 · Impacto&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;o que mais isso vai mexer?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="80" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p3_3" value="&lt;b&gt;4 · Conserto&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;mínimo até o teste passar&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="730" y="80" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p3_4" value="&lt;b&gt;5 · Validar&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;vira teste de não-regressão&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2d3d;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="80" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p3_5" value="&lt;b&gt;6 · Dados&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;checagem rápida no banco&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2d3d;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1190" y="80" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p3_6" value="&lt;b&gt;7 · Aprovar?&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;complexo demais? sobe para o pesado&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7a5c00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1420" y="80" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p3_7" value="&lt;b&gt;8 · Pá de Cal&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;selo final: vai / não vai&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1650" y="80" width="180" height="80" as="geometry"/></mxCell>
