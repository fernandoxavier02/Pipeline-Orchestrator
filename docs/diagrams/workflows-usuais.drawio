<mxCell id="d3_n" value="A fase mais densa. Primeiro os testes que devem falhar (TDD RED), depois lote a lote: cadeia por tarefa, checkpoint, três críticos em paralelo (contexto zero) e o loop de correção com disjuntor." style="text;html=1;fontSize=12;align=left;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1320" height="40" as="geometry"/></mxCell>
<mxCell id="d3_qgr" value="&lt;b&gt;quality-gate-router&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;gera cenários em linguagem simples&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="210" height="92" as="geometry"/></mxCell>
<mxCell id="d3_appr" value="&lt;b&gt;Aprova cenários?&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;um a um, antes de qualquer código&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7a5c00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="120" width="210" height="92" as="geometry"/></mxCell>
<mxCell id="d3_pre" value="&lt;b&gt;pre-tester (RED)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;escreve testes que devem falhar&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="120" width="210" height="92" as="geometry"/></mxCell>
<mxCell id="d3_batch" value="&lt;b&gt;Monta lotes&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;COMPLEXA 1 / MEDIA 2-3 / SIMPLES tudo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="120" width="210" height="92" as="geometry"/></mxCell>
<mxCell id="d3_micro" value="&lt;b&gt;micro-gate&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;5 checagens antes de codar&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7a5c00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="290" width="210" height="92" as="geometry"/></mxCell>
<mxCell id="d3_impl" value="&lt;b&gt;implementador&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;TDD RED→GREEN; trava de escopo a cada escrita&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2d3d;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="290" width="210" height="92" as="geometry"/></mxCell>
<mxCell id="d3_spec" value="&lt;b&gt;revisor de spec&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;bate com o requisito (≤2 loops)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2d3d;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="290" width="210" height="92" as="geometry"/></mxCell>
<mxCell id="d3_qual" value="&lt;b&gt;revisor de qualidade&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SOLID/KISS/DRY (≤1 loop)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2d3d;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="210" height="92" as="geometry"/></mxCell>
<mxCell id="d3_check" value="&lt;b&gt;checkpoint-validator&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;build+testes; 2 falhas seguidas = STOP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="210" height="92" as="geometry"/></mxCell>
