<diagram name="12 Revisão isolada" id="p12"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p12_t" value="12 · Revisão isolada (review-only)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell>
<mxCell id="p12_n" value="Roda só a equipe crítica final sobre o código que você já escreveu. Três revisores em paralelo, zero contexto compartilhado. Só relatório — nada é consertado nem commitado." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1040" height="40" as="geometry"/></mxCell>
<mxCell id="p12_in" value="&lt;b&gt;Árvore atual&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;mudanças não salvas inclusas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="170" height="80" as="geometry"/></mxCell>
<mxCell id="p12_auth" value="&lt;b&gt;Autorizar?&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;custo estimado de tokens&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7a5c00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="200" width="170" height="80" as="geometry"/></mxCell>
<mxCell id="p12_sec" value="&lt;b&gt;Revisor · Segurança&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;auth, injeção, vazamento de dados&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2d3d;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="80" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="p12_arc" value="&lt;b&gt;Revisor · Arquitetura&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;acoplamento, SOLID, escalabilidade&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2d3d;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="200" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="p12_qua" value="&lt;b&gt;Revisor · Qualidade&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;manutenibilidade, nomes, código morto&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2d3d;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="320" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="p12_cons" value="&lt;b&gt;Consolidar&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;achados dos 3 num relatório&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2d3d;fontSize=11;" vertex="1" parent="1"><mxGeometry x="750" y="200" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p12_del" value="&lt;b&gt;Entregar laudo&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;sem fix, sem commit, fim&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e4620;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="200" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p12_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#777777;" edge="1" parent="1" source="p12_in" target="p12_auth"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p12_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#777777;" edge="1" parent="1" source="p12_auth" target="p12_sec"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p12_e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#777777;" edge="1" parent="1" source="p12_auth" target="p12_arc"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p12_e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#777777;" edge="1" parent="1" source="p12_auth" target="p12_qua"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p12_e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#777777;" edge="1" parent="1" source="p12_sec" target="p12_cons"><mxGeometry relative="1" as="geometry"/></mxCell>
