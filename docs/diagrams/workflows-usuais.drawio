<diagram name="4 · Conserto de bug — PESADO (bug complexo / incidente em produção)" id="p4"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p4_t" value="4 · Conserto de bug — PESADO (bug complexo / incidente em produção)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell>
<mxCell id="p4_n" value="Para bugs com dados, concorrência, vários módulos ou impacto em produção. Aprovação obrigatória da proposta antes de mudar qualquer linha." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="980" height="26" as="geometry"/></mxCell>
<mxCell id="p4_0" value="&lt;b&gt;1 · Reconhecer&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;mapear o terreno do bug&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2d3d;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="180" height="80" as="geometry"/></mxCell>
