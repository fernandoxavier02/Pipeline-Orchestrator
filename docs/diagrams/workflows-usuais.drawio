<mxCell id="p8_n" value="Constrói uma feature com previsibilidade máxima. User Story usa a mesma sequência, extraindo antes os critérios de aceitação da frase (&quot;Como X, quero Y&quot;). 4 gates obrigatórios." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="980" height="26" as="geometry"/></mxCell>
