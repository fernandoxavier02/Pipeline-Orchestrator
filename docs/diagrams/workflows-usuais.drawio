<mxCell id="d2_n" value="Automático em MEDIA/COMPLEXA/Spec, opcional via --plan. Uma trava determinística impede escrever código até o plano ser aprovado por você." style="text;html=1;fontSize=12;align=left;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1320" height="40" as="geometry"/></mxCell>
<mxCell id="d2_decide" value="&lt;b&gt;Deve planejar?&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;auto MEDIA/COMPLEXA/Spec; --no-plan pula só MEDIA&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7a5c00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="210" height="92" as="geometry"/></mxCell>
