<mxCell id="d2_bc" value="&lt;b&gt;Bounded Contexts&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;só COMPLEXA (suave)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="290" width="210" height="92" as="geometry"/></mxCell>
