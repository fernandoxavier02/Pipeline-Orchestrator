<diagram name="1.0 Fase 0 · Triagem (detalhe)" id="d0"><mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2336" pageHeight="1654" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="d0_t" value="Fase 0 · Triagem — detalhe" style="text;html=1;fontSize=18;fontStyle=1;align=left;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="28" as="geometry"/></mxCell>
<mxCell id="d0_n" value="Classifica a tarefa, fecha lacunas de informação e decide o roteamento antes de propor. Cada subagente fala com você pelo protocolo de handshake (ver página própria)." style="text;html=1;fontSize=12;align=left;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1320" height="40" as="geometry"/></mxCell>
<mxCell id="d0_init" value="&lt;b&gt;Init + estado&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;cria a pasta do run + estado assinado&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="210" height="92" as="geometry"/></mxCell>
<mxCell id="d0_state" value="&lt;b&gt;STATE_FILE_INIT&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;confere gravação/assinatura — bloqueia se falhar&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="120" width="210" height="92" as="geometry"/></mxCell>
<mxCell id="d0_task" value="&lt;b&gt;task-orchestrator&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;classifica tipo, tamanho e variante&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2d3d;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="120" width="210" height="92" as="geometry"/></mxCell>
