<diagram name="10 · Plano (modo de planejamento) — fase dentro do pipeline" id="p10"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p10_t" value="10 · Plano (modo de planejamento) — fase dentro do pipeline" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell>
<mxCell id="p10_n" value="Não é um pipeline próprio: entra antes da execução. Automático em tarefas média e complexa; opcional nas simples. Modo só-leitura, você aprova antes de qualquer mudança." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="980" height="26" as="geometry"/></mxCell>
<mxCell id="p10_0" value="&lt;b&gt;1 · Vem da Fase 1&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;proposta aprovada, classificação OK&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p10_1" value="&lt;b&gt;2 · Deve planejar?&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;automático em média e complexa&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7a5c00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="80" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p10_2" value="&lt;b&gt;3 · Entra em modo plano&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;só-leitura, examina repositório e padrões&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#4a2d57;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="80" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p10_3" value="&lt;b&gt;4 · Devolve plano&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;arquivos a criar/editar, ordem, riscos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#4a2d57;fontSize=11;" vertex="1" parent="1"><mxGeometry x="730" y="80" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p10_4" value="&lt;b&gt;5 · Aprovar plano?&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;aceitar / ajustar / rejeitar&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="80" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p10_5" value="&lt;b&gt;6 · Vai para a Fase 2&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;execução em lotes com TDD&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e4620;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1190" y="80" width="180" height="80" as="geometry"/></mxCell>
