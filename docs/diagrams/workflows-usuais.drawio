</root></mxGraphModel></diagram>
<diagram name="11 · Hotfix (emergência) — reduz escopo, não segurança" id="p11"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p11_t" value="11 · Hotfix (emergência) — reduz escopo, não segurança" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell>
<mxCell id="p11_n" value="Para quando o sistema está parado e você precisa subir um conserto agora. Corta cerimônia, mantém o conserto, a revisão de segurança e o veredito." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="980" height="26" as="geometry"/></mxCell>
<mxCell id="p11_0" value="&lt;b&gt;1 · Triagem rápida&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;só perguntas críticas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p11_1" value="&lt;b&gt;2 · Confirmar&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;classificação + escopo mínimo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7a5c00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="80" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p11_2" value="&lt;b&gt;3 · Lote único&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;teste mínimo → conserto → check&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2d3d;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="80" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p11_3" value="&lt;b&gt;4 · Crítica 2x&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;só duas listas: auth + injeção&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7a5c00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="730" y="80" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p11_4" value="&lt;b&gt;5 · Sanidade&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;só build passa?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2d3d;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="80" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p11_5" value="&lt;b&gt;6 · Subir já&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;veredicto expedito + follow-up depois&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1190" y="80" width="180" height="80" as="geometry"/></mxCell>
