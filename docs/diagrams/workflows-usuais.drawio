<mxCell id="d2_plan" value="&lt;b&gt;Gera plano&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ordem de tarefas, arquivos, riscos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2d3d;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="290" width="210" height="92" as="geometry"/></mxCell>
