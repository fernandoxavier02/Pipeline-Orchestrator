<mxCell id="d2_pmreq" value="&lt;b&gt;PLAN_MODE_REQUEST&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;para e pede modo plano&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#4a2d57;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="120" width="210" height="92" as="geometry"/></mxCell>
<mxCell id="d2_enter" value="&lt;b&gt;EnterPlanMode (parent)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;pesquisa só-leitura no repositório&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#4a2d57;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1160" y="120" width="210" height="92" as="geometry"/></mxCell>
