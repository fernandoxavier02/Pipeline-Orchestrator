<diagram name="1.1 Fase 1 · Proposta (detalhe)" id="d1"><mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2336" pageHeight="1654" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="d1_t" value="Fase 1 · Proposta — detalhe" style="text;html=1;fontSize=18;fontStyle=1;align=left;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="28" as="geometry"/></mxCell>
<mxCell id="d1_n" value="Apresenta a proposta e exige sua confirmação antes de planejar. Você pode aprovar, mandar ajustar (volta à triagem) ou recusar (encerra)." style="text;html=1;fontSize=12;align=left;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1320" height="40" as="geometry"/></mxCell>
<mxCell id="d1_pres" value="&lt;b&gt;Apresenta proposta&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;tipo, nível, variante, arquivos, riscos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="210" height="92" as="geometry"/></mxCell>
<mxCell id="d1_gate" value="&lt;b&gt;Confirmar?&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Sim / Ajustar / Não (AskUserQuestion)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7a5c00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="120" width="210" height="92" as="geometry"/></mxCell>
<mxCell id="d1_log" value="&lt;b&gt;Registra decisão&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;protocol-events + gate-decisions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="120" width="210" height="92" as="geometry"/></mxCell>
<mxCell id="d1_trans" value="&lt;b&gt;→ Fase 1.5&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;inicia o placar de confiança&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e4620;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="120" width="210" height="92" as="geometry"/></mxCell>
<mxCell id="d1_adjust" value="&lt;b&gt;Ajustar&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;volta à triagem (Fase 0)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="290" width="210" height="92" as="geometry"/></mxCell>
