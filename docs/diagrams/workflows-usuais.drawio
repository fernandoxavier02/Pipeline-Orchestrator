<diagram name="0 Legenda" id="p0"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="lg_t" value="Pipeline-Orchestrator — workflows usuais (legenda das cores)" style="text;html=1;fontSize=18;fontStyle=1;align=left;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell>
<mxCell id="lg_n" value="Cada página é um workflow rodado na sua máquina (os fluxos Paperclip/servidor ficam de fora). A cor indica quem executa cada passo." style="text;html=1;fontSize=12;align=left;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1040" height="26" as="geometry"/></mxCell>
<mxCell id="lg_0" value="Passo inline do orquestrador" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="280" height="50" as="geometry"/></mxCell>
<mxCell id="lg_1" value="Subagente auxiliar (especialista)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2d3d;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="280" height="50" as="geometry"/></mxCell>
<mxCell id="lg_2" value="Gate — você decide / aprova" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7a5c00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="280" height="50" as="geometry"/></mxCell>
<mxCell id="lg_3" value="Modo plano (só-leitura)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#4a2d57;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="280" height="50" as="geometry"/></mxCell>
<mxCell id="lg_4" value="Crítico / Pá de Cal (veredito)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="280" height="50" as="geometry"/></mxCell>
<mxCell id="lg_5" value="Fechamento / entrega" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e4620;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="280" height="50" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram name="1 · Pipeline mestre — as quatro fases" id="p1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p1_t" value="1 · Pipeline mestre — as quatro fases" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell>
<mxCell id="p1_n" value="O coração do plugin. Toda tarefa passa por triagem, proposta, plano, execução em lotes com TDD e revisão crítica, e fecha com o veredito Pá de Cal." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="980" height="26" as="geometry"/></mxCell>
<mxCell id="p1_0" value="&lt;b&gt;1 · Fase 0 · Triagem&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;classifica tipo e tamanho, detecta lacunas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p1_1" value="&lt;b&gt;2 · Fase 1 · Proposta&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;mostra o plano de ação — você confirma&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7a5c00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="80" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p1_2" value="&lt;b&gt;3 · Fase 1.5 · Plano&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;modo só-leitura; plano aprovado por você&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#4a2d57;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="80" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p1_3" value="&lt;b&gt;4 · Fase 2 · Execução&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;lotes com TDD + 3 revisores críticos (loop fix ≤3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2d3d;fontSize=11;" vertex="1" parent="1"><mxGeometry x="730" y="80" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p1_4" value="&lt;b&gt;5 · Fase 3 · Fechamento&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Pá de Cal: veredicto vai / não vai&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="80" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p1_e0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#777777;" edge="1" parent="1" source="p1_0" target="p1_1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p1_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#777777;" edge="1" parent="1" source="p1_1" target="p1_2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p1_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#777777;" edge="1" parent="1" source="p1_2" target="p1_3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p1_e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#777777;" edge="1" parent="1" source="p1_3" target="p1_4"><mxGeometry relative="1" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram name="2 · Brainstorm — preparação antes do pipeline" id="p2"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p2_t" value="2 · Brainstorm — preparação antes do pipeline" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell>
<mxCell id="p2_n" value="Roda antes de construir, quando ainda falta esclarecer o que você quer. Produz uma especificação completa pronta para virar pipeline." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="980" height="26" as="geometry"/></mxCell>
<mxCell id="p2_0" value="&lt;b&gt;1 · Capturar&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;pedido original + estado do projeto&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p2_1" value="&lt;b&gt;2 · Explorar (4 fases)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;leitura → 11 lentes → perguntas com evidência&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7a5c00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="80" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p2_2" value="&lt;b&gt;3 · Alternativas&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;2-4 abordagens: mínima, padrão, agressiva, contra&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7a5c00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="80" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p2_3" value="&lt;b&gt;4 · Iniciar spec&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;cria a pasta da spec, descrição + objetivo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2d3d;fontSize=11;" vertex="1" parent="1"><mxGeometry x="730" y="80" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p2_4" value="&lt;b&gt;5 · Requisitos&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;formato EARS, critérios de aceitação&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2d3d;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="80" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p2_5" value="&lt;b&gt;6 · Gap com código&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;o que já existe? o que falta criar?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2d3d;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="260" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p2_6" value="&lt;b&gt;7 · Design&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;arquitetura, componentes, dados&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2d3d;fontSize=11;" vertex="1" parent="1"><mxGeometry x="730" y="260" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p2_7" value="&lt;b&gt;8 · Validar design&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;cobre o que os requisitos pediram?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7a5c00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="260" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p2_8" value="&lt;b&gt;9 · Tarefas&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;quebra o design em tarefas executáveis&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2d3d;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="260" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p2_9" value="&lt;b&gt;10 · Entregar&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;spec pronta · vira pipeline ou fica salva&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e4620;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="180" height="80" as="geometry"/></mxCell>
