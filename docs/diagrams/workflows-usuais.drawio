<diagram name="⊥ Protocolo de handshake (Achado #7)" id="d6"><mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2336" pageHeight="1654" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="d6_t" value="Protocolo de handshake (Achado #7) — como os subagentes falam com você" style="text;html=1;fontSize=18;fontStyle=1;align=left;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="28" as="geometry"/></mxCell>
<mxCell id="d6_n" value="Subagentes não têm acesso direto a perguntar/despachar/planejar. Eles emitem um bloco, param, e o orquestrador-pai resolve e re-despacha — repetindo até o resultado final." style="text;html=1;fontSize=12;align=left;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1320" height="40" as="geometry"/></mxCell>
<mxCell id="d6_emit" value="&lt;b&gt;Subagente emite bloco&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GATE / DISPATCH / PLAN_MODE_REQUEST&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2d3d;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="210" height="92" as="geometry"/></mxCell>
<mxCell id="d6_pause" value="&lt;b&gt;Subagente PARA&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;STATUS: AWAITING_*&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="290" width="210" height="92" as="geometry"/></mxCell>
<mxCell id="d6_parent" value="&lt;b&gt;Parent processa&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;registra em pending_blocks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="290" width="210" height="92" as="geometry"/></mxCell>
<mxCell id="d6_gate" value="&lt;b&gt;GATE_REQUEST&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ AskUserQuestion (pergunta a você)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7a5c00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="120" width="210" height="92" as="geometry"/></mxCell>
<mxCell id="d6_disp" value="&lt;b&gt;DISPATCH_REQUEST&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ Agent / Skill (roda o alvo)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2d3d;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="290" width="210" height="92" as="geometry"/></mxCell>
<mxCell id="d6_plan" value="&lt;b&gt;PLAN_MODE_REQUEST&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ EnterPlanMode (pesquisa só-leitura)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#4a2d57;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="460" width="210" height="92" as="geometry"/></mxCell>
<mxCell id="d6_payload" value="&lt;b&gt;Monta o payload&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GATE/DISPATCH/PLAN_MODE_RESULTS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1160" y="290" width="210" height="92" as="geometry"/></mxCell>
<mxCell id="d6_redisp" value="&lt;b&gt;Re-despacha o MESMO subagente&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;chamada Agent nova; recupera estado do run-dir&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2d3d;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1440" y="290" width="210" height="92" as="geometry"/></mxCell>
<mxCell id="d6_timeout" value="&lt;b&gt;HANDSHAKE_TIMEOUT&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;30 min sem resposta → bloqueia (2 camadas)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a1f1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="460" width="210" height="92" as="geometry"/></mxCell>
