<mxCell id="p12_e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#777777;" edge="1" parent="1" source="p12_qua" target="p12_cons"><mxGeometry relative="1" as="geometry"/></mxCell>
