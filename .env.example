# =============================================================================
# Pipeline-Orchestrator — Example environment file
# =============================================================================
# Copy this file to `.env` and fill in real values to enable opt-in features.
# Defaults shipped here are SAFE: the plugin behaves identically to a no-Langfuse
# install when this file is copied verbatim.
#
#   cp .env.example .env
#
# Real secrets MUST NEVER be committed. `.env` is gitignored.
# =============================================================================


# === Langfuse Cloud Observability (OPT-IN) ===
#
# Optional integration with Langfuse Cloud (https://cloud.langfuse.com) for
# trace/span telemetry across pipeline phases, agent dispatches, and gate
# decisions. Disabled by default — copying this file produces zero behavior
# change versus a no-Langfuse install.
#
# To enable:
#   1) Sign up at https://cloud.langfuse.com and create a project.
#   2) Copy the project's public + secret keys into the two slots below.
#   3) Set LANGFUSE_ENABLED=true.
#
# The plugin auto-disables and logs `missing_credentials` if ENABLED=true but
# either key is empty.

# Master switch — set to "true" or "1" to enable Langfuse emission.
# Leave as "false" (or unset) to keep the plugin in its default no-op mode.
LANGFUSE_ENABLED=false

# Public key (project-scoped, safe to embed in client-side code).
# Format: pk-lf-<uuid>. Placeholder below is NOT a real key.
LANGFUSE_PUBLIC_KEY=pk-lf-0000-0000-0000-0000

# Secret key (server-side only, NEVER commit a real value).
# Format: sk-lf-<uuid>. Placeholder below is NOT a real key.
LANGFUSE_SECRET_KEY=sk-lf-0000-0000-0000-0000

# Optional — override default Langfuse Cloud endpoint (e.g. for self-hosted).
# Default: https://cloud.langfuse.com
# LANGFUSE_HOST=https://cloud.langfuse.com

# Optional — sampling rate in [0.0, 1.0]. 1.0 = trace every invocation;
# 0.0 = sample nothing (effectively disabled). Out-of-range values fall back
# to 1.0 and a one-time `invalid_sample_rate` warning is logged.
# LANGFUSE_SAMPLE_RATE=1.0
