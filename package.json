{
  "name": "@fx-studio-ai/pipeline-orchestrator",
  "version": "8.18.0",
  "description": "Multi-agent governance layer for Claude Code, Cursor, and OpenCode — sits between your spec and production code with deterministic enforcement, TDD, parallel adversarial review, a 49-gate hierarchy, and a glass-box audit trail. v8.18.0.",
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "pipeline",
    "tdd",
    "multi-agent",
    "orchestration",
    "code-quality",
    "adversarial-review",
    "batch-execution",
    "audit-trail",
    "spec-driven",
    "atdd",
    "bdd",
    "ddd"
  ],
  "homepage": "https://github.com/fernandoxavier02/Pipeline-Orchestrator#readme",
  "bugs": {
    "url": "https://github.com/fernandoxavier02/Pipeline-Orchestrator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fernandoxavier02/Pipeline-Orchestrator.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "FX Studio AI",
    "url": "https://github.com/fernandoxavier02"
  },
  "type": "commonjs",
  "main": "lib/index.cjs",
  "exports": {
    ".": "./lib/index.cjs",
    "./jsonl-sanitizer": "./lib/jsonl-sanitizer.cjs",
    "./sentinel-state-signer": "./lib/sentinel-state-signer.cjs",
    "./pipeline-local-parser": "./lib/pipeline-local-parser.cjs",
    "./codex-operational-runtime": "./lib/codex-operational-runtime.cjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "pipeline-orchestrator-validate-trace": "./scripts/validate-trace.cjs"
  },
  "files": [
    "agents/",
    "skills/",
    "commands/",
    "references/",
    "lib/",
    "scripts/",
    ".claude-plugin/",
    "hooks/",
    ".claude/hooks/",
    "assets/",
    "docs/diagrams/",
    "docs/audits/",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CLAUDE.md",
    "node_modules/langfuse/",
    "node_modules/langfuse-core/",
    "node_modules/mustache/"
  ],
  "scripts": {
    "lint:types": "node scripts/lint-types.cjs",
    "build": "node scripts/build.cjs",
    "test": "node scripts/run-tests.cjs",
    "test:regression": "node scripts/run-tests.cjs --regression",
    "test:hooks": "node scripts/run-tests.cjs --hooks",
    "validate-trace": "node scripts/validate-trace.cjs",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "dependencies": {
    "langfuse": "3.38.4"
  },
  "bundledDependencies": [
    "langfuse",
    "langfuse-core",
    "mustache"
  ]
}
