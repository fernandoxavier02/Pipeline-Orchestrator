{
  "name": "@fx-studio-ai/pipeline-orchestrator",
  "version": "6.2.0",
  "description": "End-to-end execution governance for Claude Code. Multi-agent pipeline with TDD, adversarial review, 27-gate registry, glass-box TRACE.md audit trail. v6.2.0: dynamic exhaustive clarification (replaces fixed 7-Q template), alternative-approach brainstorming, AUDIT hardness level, complexity-matrix drift fix (spec mandatory for MEDIA/COMPLEXA).",
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "pipeline",
    "tdd",
    "multi-agent",
    "orchestration",
    "code-quality",
    "adversarial-review",
    "batch-execution",
    "audit-trail",
    "spec-driven",
    "atdd",
    "bdd",
    "ddd"
  ],
  "homepage": "https://github.com/fernandoxavier02/Pipeline-Orchestrator#readme",
  "bugs": {
    "url": "https://github.com/fernandoxavier02/Pipeline-Orchestrator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fernandoxavier02/Pipeline-Orchestrator.git"
  },
  "license": "MIT",
  "author": {
    "name": "FX Studio AI",
    "url": "https://github.com/fernandoxavier02"
  },
  "type": "commonjs",
  "main": "lib/index.cjs",
  "exports": {
    ".": "./lib/index.cjs",
    "./jsonl-sanitizer": "./lib/jsonl-sanitizer.cjs",
    "./sentinel-state-signer": "./lib/sentinel-state-signer.cjs",
    "./pipeline-local-parser": "./lib/pipeline-local-parser.cjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "pipeline-orchestrator-validate-trace": "./scripts/validate-trace.cjs"
  },
  "files": [
    "agents/",
    "skills/",
    "commands/",
    "references/",
    "lib/",
    "scripts/",
    ".claude-plugin/",
    ".claude/hooks/",
    "assets/",
    "docs/diagrams/",
    "docs/audits/",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "CLAUDE.md"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "test:regression": "node scripts/run-tests.cjs --regression",
    "test:hooks": "node scripts/run-tests.cjs --hooks",
    "validate-trace": "node scripts/validate-trace.cjs",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
